# Required for AI meal planning and pantry photo scanning.
# Without it the app still works using the built-in rule-based planner.
ANTHROPIC_API_KEY=

# Optional: real Google Calendar import (read-only). Without it, "Connect Google Calendar" runs a demo.
# Create an OAuth client ID (type: Web application) in Google Cloud, enable the Calendar API,
# and add http://localhost:3000 under "Authorized JavaScript origins". See README.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Monad testnet checkout: the app's own testnet wallet (deploys contracts, pays gas for demo users).
# Create it with `npm run monad:wallet` (it fills this in), fund it at https://faucet.monad.xyz,
# then run `npm run monad:deploy`. Testnet only, never put a real wallet's key here.
MONAD_DEPLOYER_KEY=
